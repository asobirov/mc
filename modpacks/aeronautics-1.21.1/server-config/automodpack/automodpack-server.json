{
  "DO_NOT_CHANGE_IT": 2,
  "modpackName": "Friends MC",
  "modpackHost": true,
  "generateModpackOnStart": true,
  "syncedFiles": ["/mods/*.jar", "!/mods/bluemap*.jar"],
  "allowEditsInFiles": ["/config/**", "/options.txt"],
  "forceCopyFilesToStandardLocation": [],
  "nonModpackFilesToDelete": {},
  "autoExcludeServerSideMods": true,
  "autoExcludeUnnecessaryFiles": true,
  "requireAutoModpackOnClient": false,
  "nagUnModdedClients": true,
  "nagMessage": "Friends MC now supports automatic modpack updates.",
  "nagClickableMessage": "Open the one-time upgrade guide",
  "nagClickableLink": "https://mc.xpr.im/faq",
  "bindAddress": "",
  "bindPort": -1,
  "addressToSend": "mc.xpr.im",
  "portToSend": -1,
  "disableInternalTLS": false,
  "requireMagicPackets": false,
  "updateIpsOnEveryStart": false,
  "bandwidthLimit": 0,
  "validateSecrets": true,
  "secretLifetime": 336,
  "selfUpdater": false,
  "acceptedLoaders": ["neoforge"]
}
