NODE_ENV=development
PORT=3001
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Optional until the Discord OAuth application is provisioned.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional until the Microsoft Entra application is provisioned.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Break-glass owners. These accounts are always bootstrapped as trusted admins.
AUTH_ADMIN_EMAILS=you@example.com
SQLITE_PATH=./data/auth.sqlite
MODPACK_PATH=../../modpacks/aeronautics-1.21.1/pack/Friends-MC-1.1.1.mrpack
# Optional locally; production connects over a private Docker network.
MINECRAFT_RCON_HOST=
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=
MINECRAFT_LOG_PATH=
