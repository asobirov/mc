{
  "name": "@mc/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsup src/server/index.ts --format esm --platform node --target node22 --out-dir server-dist --sourcemap",
    "clean": "git clean -xdf .cache .turbo dist server-dist node_modules",
    "dev": "concurrently -k -n web,api -c cyan,green \"vite --host 0.0.0.0\" \"tsx watch src/server/index.ts\"",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "start": "node server-dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@tanstack/react-router": "^1.170.24",
    "better-auth": "1.6.22",
    "hono": "^4.12.8",
    "lucide-react": "^0.577.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "catalog:zod4"
  },
  "devDependencies": {
    "@mc/eslint-config": "workspace:*",
    "@mc/prettier-config": "workspace:*",
    "@mc/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.13.11",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.23.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.0"
  },
  "prettier": "@mc/prettier-config"
}
